# Copy this file to .env on each computer. Never commit real secret values.
SUPABASE_URL=https://cmexmobjpeavlppmffqi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVAL_CHAT_ID=

# Scan configuration: both ordinary collection and competitor discovery use 3 workers.
COLLECTOR_WORKERS=3
DEAL_COMPETITOR_WORKERS=3
AMAZON_ENABLED=1
AMAZON_DEALS_ENABLED=1
TRENDYOL_DEALS_ENABLED=1
HEPSIBURADA_DEALS_ENABLED=1

# Optional local publishing/helper configuration. Cloud secrets are configured separately.
TELEGRAM_STORY_CHAT_ID=
TELEGRAM_PUBLISH_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
FACEBOOK_PAGE_ID=
FACEBOOK_SYSTEM_USER_TOKEN=

# Repeat notification requires at least a 15% drop from the last sent price.
REDISPATCH_PRICE_DROP_PERCENT=15

# Same vertical H.264 quality target, faster local encoding.
REELS_ENCODER_PRESET=veryfast
